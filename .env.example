# ============================================================
# PAPERLESS CAMPUS — PRODUCTION ENVIRONMENT CONFIGURATION
# University of Rizal System – Cainta Campus
# ============================================================

# 1. PostgreSQL Database Connection String
# Compatible with Neon, Supabase, Railway, Vercel Postgres, AWS RDS
DATABASE_URL="postgresql://username:password@hostname:5432/paperless_campus?sslmode=require"

# 2. NextAuth Production URL & Secret
# Set NEXTAUTH_URL to your public production domain (e.g. https://paperless-campus.vercel.app)
NEXTAUTH_URL="https://your-production-domain.com"
NEXTAUTH_SECRET="generate-a-strong-random-32-character-secret"

# 3. Public Application Domain
# Strictly used for generating dynamic public Event Registration QR Codes & tickets
NEXT_PUBLIC_APP_URL="https://your-production-domain.com"
